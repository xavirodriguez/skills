{
  "skills": {
    "auto_discover": true,
    "paths": [
      ".codex/skills/",
      ".opencode/skills/"
    ]
  },
  "permissions": {
    "bash": {
      "allow": [
        "python *decomp/scripts/*",
        "python *.py *",
        "powershell.exe *preflight.ps1 *",
        "analyzeHeadless *",
        "analyzeHeadless.bat *",
        "ninja *",
        "objdiff *"
      ]
    }
  },
  "session_policy": {
    "path": ".decomp-agent/session-policy.json",
    "enforced_by": [
      "decomp/scripts/run_match.py",
      "decomp/scripts/challenge.py",
      "decomp/scripts/challenge_autopilot.py",
      "decomp/scripts/challenge_selector.py",
      "decomp/scripts/candidate_gate.py"
    ]
  }
}
